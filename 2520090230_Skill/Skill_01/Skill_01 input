#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main() {

    pid_t child1, child2;

    printf("Parent PID: %d\n", getpid());

    child1 = fork();

    if (child1 < 0) {
        perror("fork");
        return 1;
    }

    if (child1 == 0) {

        printf("Child 1 PID: %d\n", getpid());
        printf("Child 1 Parent PID: %d\n", getppid());

        sleep(10);

        return 0;
    }

    child2 = fork();

    if (child2 < 0) {
        perror("fork");
        return 1;
    }

    if (child2 == 0) {

        printf("Child 2 PID: %d\n", getpid());
        printf("Child 2 Parent PID: %d\n", getppid());

        sleep(10);

        return 0;
    }

    printf("Parent created two children.\n");
    printf("Child 1 PID: %d\n", child1);
    printf("Child 2 PID: %d\n", child2);

    wait(NULL);
    wait(NULL);

    printf("Parent finished.\n");

    return 0;
}
